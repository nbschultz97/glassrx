# GlassRx — Voice Input Configuration
#
# Voice input is routed through the GlassRx STT proxy Worker so the Deepgram
# key stays server-side. Deploy ../glassrx-worker, then set its origin here.
VITE_STT_PROXY_URL=https://glassrx-stt-proxy.<your-account>.workers.dev

# LOCAL DEVELOPMENT ONLY — talk to Deepgram directly, skipping the Worker.
# `npm run build` refuses to run while this is set, because the key would be
# baked into the bundle that ships to users. Free key (200 min):
#   https://console.deepgram.com
# VITE_STT_API_KEY=your_deepgram_api_key_here
