# GlassRx configuration
#
# Both values point at deployed infrastructure. With neither set, the app
# builds as the free tier: presets only, no permissions, no network calls.

# Origin of the GlassRx Worker (../glassrx-worker). Enables voice input and
# the Pro tier, and is what makes scripts/pack.mjs declare the g2-microphone
# and network permissions in the manifest.
VITE_STT_PROXY_URL=https://glassrx-stt-proxy.<your-account>.workers.dev

# Page where users enter their device code and subscribe. Shown on the
# glasses, so keep it short and typeable.
VITE_PRO_URL=nbschultz97.github.io/glassrx-site/pro.html

# LOCAL DEVELOPMENT ONLY — talk to Deepgram directly, bypassing the Worker.
# `npm run build` refuses to run while this is set, because the key would be
# baked into the bundle that ships to users inside the .ehpk.
# VITE_STT_API_KEY=your_deepgram_api_key_here
